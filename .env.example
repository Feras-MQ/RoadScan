# Local development only. Use PostgreSQL in pilot environments.
DATABASE_URL=sqlite:///./roadscan.db
ROADSCAN_STORAGE=./private_uploads
ROADSCAN_API_KEY=replace-with-long-random-secret
ROADSCAN_RETENTION_DAYS=30
ROADSCAN_MODEL_PATH=
ROADSCAN_MAX_UPLOAD_MB=10
# Optional read-only and reviewer keys. Legacy ROADSCAN_API_KEY is local admin.
ROADSCAN_REVIEWER_KEY=
ROADSCAN_VIEWER_KEY=
